								<goals>
									<goal>wsdl2java</goal>
								</goals>
								<configuration>
									<sourceRoot>${project.build.directory}/generated-sources/cxf</sourceRoot>
									<wsdlOptions>
										<wsdlOption>
											<wsdl>${project.basedir}/src/main/resources/wsdl/pricing/PricingAndConfiguration.wsdl</wsdl>
											<wsdlLocation>classpath:wsdl/pricing/PricingAndConfiguration.wsdl</wsdlLocation>
											<extraargs>
												<extraarg>-client</extraarg>
												<!-- Package overrides, one per targetNamespace found in the WSDL/XSDs -->
												<extraarg>-p</extraarg>
												<extraarg>http://www.promostandards.org/WSDL/PricingAndConfiguration/1.0.0/=com.trophy.promostandards.pricing.soap</extraarg>
												<extraarg>-p</extraarg>
												<extraarg>http://www.promostandards.org/WSDL/PricingAndConfiguration/1.0.0/SharedObjects/=com.trophy.promostandards.pricing.soap.shared</extraarg>
												<extraarg>-p</extraarg>
												<extraarg>http://www.codesynthesis.com/xmlns/xsstl=com.trophy.promostandards.pricing.soap.xsstl</extraarg>
												<extraarg>-p</extraarg>
												<extraarg>http://www.isotc211.org/iso4217/=com.trophy.promostandards.pricing.soap.iso4217</extraarg>
											</extraargs>
										</wsdlOption>
									</wsdlOptions>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

