											<wsdlLocation>classpath:wsdl/media/MediaContentService.wsdl</wsdlLocation>
											<extraargs>
												<extraarg>-client</extraarg>
												<!-- Package overrides, one per targetNamespace found in the WSDL/XSDs -->
												<extraarg>-p</extraarg>
												<extraarg>http://www.promostandards.org/WSDL/MediaService/1.0.0/=com.trophy.promostandards.media.soap</extraarg>
												<extraarg>-p</extraarg>
												<extraarg>http://www.promostandards.org/WSDL/MediaService/1.0.0/SharedObjects/=com.trophy.promostandards.media.soap.shared</extraarg>
											</extraargs>
										</wsdlOption>
									</wsdlOptions>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
		  Pricing & Configuration SOAP client codegen. Auto-activates once the PPC WSDL is vendored
		  at the path below. Generates JAX-WS stubs into target/generated-sources/cxf.
		-->
		<profile>
			<id>pricing-soap-codegen</id>
			<activation>
