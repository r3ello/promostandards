<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.15</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.trophy</groupId>
	<artifactId>promostandards</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
		<cxf.version>4.0.5</cxf.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- /actuator/health for the Docker container healthcheck (see Dockerfile) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Persistence (Postgres). Only active when sync.persistence.enabled=true — see
		     PersistenceAutoConfigurationExcluder: with the flag off, the DataSource/Flyway
		     auto-configuration is excluded so a missing DB_URL cannot fail startup.
		     JdbcClient rather than an ORM: nearly every write here is an `on conflict` merge. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Schema migrations. Flyway 10+ needs the per-database module alongside the core. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- PromoStandards SOAP clients: CXF JAX-WS runtime + JAXB databinding -->
		<dependency>
			<groupId>org.apache.cxf</groupId>
			<artifactId>cxf-spring-boot-starter-jaxws</artifactId>
			<version>${cxf.version}</version>
		</dependency>

		<!-- Optional SOAP message logging (LoggingFeature); enabled via promostandards.*.log-messages -->
		<dependency>
			<groupId>org.apache.cxf</groupId>
			<artifactId>cxf-rt-features-logging</artifactId>
			<version>${cxf.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
		  SOAP client codegen. Auto-activates once the Inventory WSDL is vendored at the path
		  below, so the default build stays green until then. Generates JAX-WS stubs into
		  target/generated-sources/cxf during the generate-sources phase.
		  Name your WSDL exactly as below, or update both the <exists> and <wsdl> paths to match.
		-->
		<profile>
			<id>inventory-soap-codegen</id>
			<activation>
				<file>
					<exists>src/main/resources/wsdl/inventory/InventoryService.wsdl</exists>
				</file>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.cxf</groupId>
						<artifactId>cxf-codegen-plugin</artifactId>
						<version>${cxf.version}</version>
						<executions>
							<execution>
								<id>generate-inventory-client</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>wsdl2java</goal>
								</goals>
								<configuration>
									<sourceRoot>${project.build.directory}/generated-sources/cxf</sourceRoot>
									<wsdlOptions>
										<wsdlOption>
											<wsdl>${project.basedir}/src/main/resources/wsdl/inventory/InventoryService.wsdl</wsdl>
											<wsdlLocation>classpath:wsdl/inventory/InventoryService.wsdl</wsdlLocation>
											<extraargs>
												<extraarg>-client</extraarg>
												<!-- Package overrides, one per targetNamespace found in the WSDL/XSDs.
												     INV 1.2.1 uses a single namespace (no SharedObjects/xsstl). -->
												<extraarg>-p</extraarg>
												<extraarg>http://www.promostandards.org/WSDL/InventoryService/1.0.0/=com.trophy.promostandards.inventory.soap</extraarg>
											</extraargs>
										</wsdlOption>
									</wsdlOptions>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
		  Product Data SOAP client codegen. Auto-activates once the Product Data WSDL is vendored
		  at the path below. Generates JAX-WS stubs into target/generated-sources/cxf.
		-->
		<profile>
			<id>product-data-soap-codegen</id>
			<activation>
				<file>
					<exists>src/main/resources/wsdl/product/ProductDataService.wsdl</exists>
				</file>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.cxf</groupId>
						<artifactId>cxf-codegen-plugin</artifactId>
						<version>${cxf.version}</version>
						<executions>
							<execution>
								<id>generate-product-data-client</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>wsdl2java</goal>
								</goals>
								<configuration>
									<sourceRoot>${project.build.directory}/generated-sources/cxf</sourceRoot>
									<wsdlOptions>
										<wsdlOption>
											<wsdl>${project.basedir}/src/main/resources/wsdl/product/ProductDataService.wsdl</wsdl>
											<wsdlLocation>classpath:wsdl/product/ProductDataService.wsdl</wsdlLocation>
											<extraargs>
												<extraarg>-client</extraarg>
												<!-- Package overrides, one per targetNamespace found in the WSDL/XSDs -->
												<extraarg>-p</extraarg>
												<extraarg>http://www.promostandards.org/WSDL/ProductDataService/1.0.0/=com.trophy.promostandards.productdata.soap</extraarg>
												<extraarg>-p</extraarg>
												<extraarg>http://www.promostandards.org/WSDL/ProductDataService/1.0.0/SharedObjects/=com.trophy.promostandards.productdata.soap.shared</extraarg>
												<extraarg>-p</extraarg>
												<extraarg>http://www.codesynthesis.com/xmlns/xsstl=com.trophy.promostandards.productdata.soap.xsstl</extraarg>
											</extraargs>
										</wsdlOption>
									</wsdlOptions>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
		  Media Content SOAP client codegen. Auto-activates once the Media WSDL is vendored at the
