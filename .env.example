# Copy to `.env` on the server and fill in the real values (never commit `.env`).
# The real values currently live in src/main/resources/application-local.yaml on the
# development machine — copy them from there.

# --- PaceSetter (PromoStandards) supplier account ---------------------------------
PROMOSTANDARDS_CREDENTIALS_ID=CHANGE_ME
PROMOSTANDARDS_CREDENTIALS_PASSWORD=CHANGE_ME

# Endpoint URLs default to the PaceSetter production services (application-prod.yaml).
# Uncomment to override:
# PROMOSTANDARDS_INVENTORY_ENDPOINT=
# PROMOSTANDARDS_PRODUCT_ENDPOINT=
# PROMOSTANDARDS_PRICING_ENDPOINT=
# PROMOSTANDARDS_MEDIA_ENDPOINT=
# PROMOSTANDARDS_ORDER_SHIPMENT_ENDPOINT=
# PROMOSTANDARDS_ORDER_STATUS_ENDPOINT=

# --- Shopify Admin API (sync target) ----------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=CHANGE_ME
SHOPIFY_CLIENT_SECRET=CHANGE_ME
SHOPIFY_WEBHOOK_SECRET=CHANGE_ME
# Inventory location GID quantities are written to:
SHOPIFY_LOCATION_ID=gid://shopify/Location/74343743582
# SHOPIFY_API_VERSION=2026-04

# --- App login (HTTP Basic) --------------------------------------------------------
# Protects the console + REST API in the prod profile. Pick your own username/password;
# the browser will prompt for these. Leaving the password blank locks everyone out (401).
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=CHANGE_ME

# --- Sync scheduler ----------------------------------------------------------------
# Keep false until the deployment is smoke-tested; then set true and `docker compose up -d`.
SYNC_SCHEDULE_ENABLED=false
# Evaluate every product and log what WOULD be pushed, without writing to Shopify. Use it for the
# first scheduled runs after enabling persistence to prove the incremental logic (see DEPLOY.md §6).
# It covers the whole scheduler: the order job, which creates fulfillments, is skipped while it is on.
SYNC_SCHEDULE_DRY_RUN=false

# --- Retail pricing ----------------------------------------------------------------
# SUPPLIER_LIST publishes PaceSetter's own suggested retail (their priceType=List, the same figure
# their public product page shows) and falls back to the markup only where they publish none.
# MARKUP ignores their retail price and always computes net * (1 + markup).
SYNC_PRICING_STRATEGY=SUPPLIER_LIST
# Fallback markup, in percent. Only used when the supplier publishes no retail price.
SYNC_PRICING_MARKUP_PERCENT=40
SYNC_PRICING_ROUNDING=NINETY_NINE
SYNC_PRICING_MAP_FLOOR=true

# --- Timezone ----------------------------------------------------------------------
# Decides the zone the cron schedules run in ("daily at 03:00" is local to this zone) AND the
# TimeZone value the Postgres driver sends on connect — a zone your Postgres does not recognise
# fails the connection with: FATAL: invalid value for parameter "TimeZone".
# US options: America/New_York | America/Chicago | America/Denver | America/Los_Angeles
APP_TIMEZONE=America/New_York

# --- Postgres (catalog mirror + sync bookkeeping) ----------------------------------
# Off by default: the app runs exactly as before, with no database at all. Turn it on only
# after the database exists and the container can reach it (see DEPLOY.md). Rolling back is
# setting this back to false and restarting — the database is left untouched.
SYNC_PERSISTENCE_ENABLED=false
# The app runs in Docker and Postgres on the host, so the host is reached through the gateway
# alias mapped in docker-compose.yaml (extra_hosts), NOT localhost — inside the container
# localhost is the container itself.
DB_URL=jdbc:postgresql://host.docker.internal:5432/promostandards
DB_USER=promostandards
DB_PASSWORD=CHANGE_ME
