# Copy to `.env` on the server and fill in the real values (never commit `.env`).
# The real values currently live in src/main/resources/application-local.yaml on the
# development machine — copy them from there.

# --- PaceSetter (PromoStandards) supplier account ---------------------------------
PROMOSTANDARDS_CREDENTIALS_ID=CHANGE_ME
PROMOSTANDARDS_CREDENTIALS_PASSWORD=CHANGE_ME

# Endpoint URLs default to the PaceSetter production services (application-prod.yaml).
# Uncomment to override:
# PROMOSTANDARDS_INVENTORY_ENDPOINT=
# PROMOSTANDARDS_PRODUCT_ENDPOINT=
# PROMOSTANDARDS_PRICING_ENDPOINT=
# PROMOSTANDARDS_MEDIA_ENDPOINT=
# PROMOSTANDARDS_ORDER_SHIPMENT_ENDPOINT=
# PROMOSTANDARDS_ORDER_STATUS_ENDPOINT=

# --- Shopify Admin API (sync target) ----------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=CHANGE_ME
SHOPIFY_CLIENT_SECRET=CHANGE_ME
SHOPIFY_WEBHOOK_SECRET=CHANGE_ME
# Inventory location GID quantities are written to:
SHOPIFY_LOCATION_ID=gid://shopify/Location/74343743582
# SHOPIFY_API_VERSION=2026-04

# --- Sync scheduler ----------------------------------------------------------------
# Keep false until the deployment is smoke-tested; then set true and `docker compose up -d`.
SYNC_SCHEDULE_ENABLED=false
